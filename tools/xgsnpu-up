#!/bin/sh
# Release the Sophos XGS NPU from reset and load xgsnpu (front ports).
# Safe to run repeatedly: an already-loaded driver is removed first (the NPU only
# accepts one host session per boot, so every load needs a fresh reset pulse).
DEV=/sys/bus/pci/devices/0000:01:00.0
LOG=/var/log/xgsnpu-npu-console.log
PIDF=/run/xgsnpu-console.pid
MCP=/usr/local/lib/xgsnpu/mcp2210.py

[ "$(cat $DEV/vendor 2>/dev/null)" = "0x11ab" ] || { echo "xgsnpu: no NPU endpoint at 01:00.0"; exit 0; }
[ -c /dev/hidraw0 ] || { echo "xgsnpu: no MCP2210 bridge (/dev/hidraw0)"; exit 0; }

lsmod | grep -q '^xgsnpu' && rmmod xgsnpu
[ -f $PIDF ] && kill "$(cat $PIDF)" 2>/dev/null; rm -f $PIDF

# NPU console, echo OFF (echo derails its U-Boot), hard timeout
sh -c 'exec </dev/ttyS2; stty 115200 cs8 -parenb -cstopb clocal -crtscts -ixon -ixoff -hupcl raw -echo -echoe -echok -echonl -isig -icanon -iexten -opost; exec timeout 300 cat' > $LOG 2>/dev/null &
echo $! > $PIDF
sleep 1

python3 $MCP pulse || { echo "xgsnpu: reset pulse failed"; exit 1; }
i=0
while [ $i -lt 90 ]; do
	grep -aq "Waiting for host driver handshake" $LOG && break
	sleep 1; i=$((i+1))
done
[ $i -ge 90 ] && echo "xgsnpu: NPU console never reported the handshake wait - trying anyway"
echo "xgsnpu: NPU up after ${i}s, restoring BARs"
echo 1 > $DEV/remove; sleep 1; echo 1 > /sys/bus/pci/rescan; sleep 2
modprobe xgsnpu "$@"
# give the driver time to create the netdevs so ifupdown's hotplug sees them
i=0; while [ $i -lt 60 ] && [ ! -e /sys/class/net/port1 ]; do sleep 1; i=$((i+1)); done
[ -e /sys/class/net/port1 ] && echo "xgsnpu: front ports registered" || echo "xgsnpu: ports did not appear - see dmesg"
